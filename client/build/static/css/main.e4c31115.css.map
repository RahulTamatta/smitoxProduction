/* Order Modal Responsive Styles */
.order-modal {
  z-index: 1050 !important;
}

.order-modal .modal-dialog {
  width: 100%;
  max-width: 900px;
  margin: auto;
  z-index: 1050 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.order-modal .modal-content {
  width: 60vw;
  max-width: 900px;
  height: 80vh;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
}

.modal-90w {
  width: 90%;
  max-width: none;
}

/* Ensure modal backdrop is behind the modal */
.modal-backdrop {
  z-index: 1040 !important;
}

/* Tracking Modal Styles */
.tracking-modal {
  z-index: 1051 !important;
}

.tracking-modal .modal-dialog {
  z-index: 1051 !important;
}

.tracking-modal .modal-content {
  border-radius: 8px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
}

.tracking-modal .modal-header {
  background: #f8f9fa;
  border-bottom: 1px solid #dee2e6;
  padding: 1.25rem;
}

.tracking-modal .modal-title {
  font-weight: 600;
  color: #0f172a;
}

.tracking-modal .modal-body {
  padding: 1.5rem;
}

.tracking-modal .form-label {
  font-weight: 500;
  color: #2d3748;
  margin-bottom: 0.5rem;
  font-size: 0.95rem;
}

.tracking-modal .form-control {
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  padding: 0.625rem 0.875rem;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.tracking-modal .form-control:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
}

.tracking-modal .modal-footer {
  padding: 1rem 1.5rem;
  border-top: 1px solid #dee2e6;
  background: #f8f9fa;
  gap: 0.75rem;
}

.tracking-modal .btn {
  border-radius: 6px;
  font-weight: 500;
  padding: 0.625rem 1.25rem;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.tracking-modal .btn-primary {
  background: #0d6efd;
  border-color: #0d6efd;
}

.tracking-modal .btn-primary:hover {
  background: #0b5ed7;
  border-color: #0b5ed7;
}

.tracking-modal .btn-secondary {
  background: white;
  border-color: #dee2e6;
  color: #4a5568;
}

.tracking-modal .btn-secondary:hover {
  background: #f8f9fa;
  border-color: #adb5bd;
}

/* Mobile devices (up to 480px) */
@media (max-width: 480px) {
  .order-modal .modal-dialog {
    width: 100%;
    max-width: 95vw;
    margin: 0;
    min-height: 100vh;
    align-items: flex-start;
    padding: 0.5rem 0;
  }
  
  .order-modal .modal-content {
    width: 95vw;
    max-width: 95vw;
    height: 90vh;
    max-height: 90vh;
    border-radius: 8px;
    margin-top: 0.5rem;
  }
  
  .order-modal .modal-header {
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #dee2e6;
    flex-shrink: 0;
    background: #f8f9fa;
  }
  
  .order-modal .modal-title {
    font-size: 1rem;
    font-weight: 600;
  }
  
  .order-modal .modal-body {
    padding: 1rem;
    max-height: calc(90vh - 140px);
    overflow-y: auto;
    flex: 1;
    -webkit-overflow-scrolling: touch;
  }
  
  .order-modal .modal-footer {
    padding: 0.75rem 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
    border-top: 1px solid #dee2e6;
    background: #f8f9fa;
  }
  
  .order-modal .modal-footer .btn {
    flex: 1;
    min-width: 80px;
    padding: 0.625rem 0.75rem;
    font-size: 0.85rem;
    margin: 0.25rem 0;
    border-radius: 6px;
    font-weight: 500;
  }
}

