{
  "name": "smitox-production",
  "version": "1.0.0",
  "private": true,
  "description": "Smitox production workspace",
  "postinstall": "npm run install:all",
  "scripts": {
    "install:all": "npm install --prefix server --legacy-peer-deps && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "dev": "npm run dev --prefix server",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:server": "npm test --prefix server"
  }
}
