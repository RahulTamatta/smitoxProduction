{
  "name": "ecommerce-app-2023",
  "proxy": "http://127.0.0.1:5000",
  "version": "1.0.0",
  "description": "ecommerce rest api",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix ../client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "prestart": "node setup.cjs",
    "sync-deps": "npm install && npm dedupe",
    "prepare": "node scripts/prepare.js",
    "build": "node scripts/build.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/rbac.integration.test.js",
    "search:reindex": "node scripts/reindex.js"
  },
  "keywords": [],
  "author": "Rahul Tamatta",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.0",
    "@sendgrid/mail": "^7.7.0",
    "@sentry/node": "^7.120.3",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.3",
    "colors": "^1.4.0",
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-writer": "^1.6.0",
    "datatables.net-dt": "^2.0.8",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "firebase-admin": "^13.10.0",
    "formidable": "^3.5.2",
    "hamming-distance": "^1.0.0",
    "imagekit": "^4.1.4",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "4.17.2",
    "mongoose": "^6.13.8",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemon": "^2.0.20",
    "razorpay": "^2.9.5",
    "redis": "^4.6.11",
    "slugify": "^1.6.5",
    "util": "^0.12.5",
    "uuid": "^8.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.1",
    "form-data": "^4.0.5",
    "globals": "^15.10.0",
    "https-browserify": "^1.0.0",
    "jest": "^29.7.0",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "react-app-rewired": "^2.2.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleFileExtensions": [
      "js"
    ],
    "verbose": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
